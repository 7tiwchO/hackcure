DATABASE_URL=sqlite+aiosqlite:///./hackcure.db
SECRET_KEY=your-super-secret-key-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5
SAKINA_MODEL=claude-sonnet-4-6
TRIAGE_MODEL=claude-haiku-4-5-20251001
CHAT_MAX_TOKENS=700
CHAT_TIMEOUT_SECONDS=45
CHAT_RATE_LIMIT_PER_MINUTE=12
CHAT_N8N_WEBHOOK_BASE_URL=
CHAT_N8N_CHAT_WEBHOOK_URL=
CHAT_N8N_SHARED_SECRET=
CHAT_DIAGNOSTIC_TOKEN=
CHAT_DEFAULT_COUNTRY=TN
PATIENT_TIMEZONE=Africa/Tunis

# --- Lien avec la plateforme hospitaliere Hospital Copilot (API FHIR en lecture) ---
HOSPITAL_COPILOT_URL=http://localhost:8000
# Jeton de service de l'hopital (= PLATFORM_SERVICE_TOKEN dans Hospital_copilot/.env). Vide = liaison impossible.
HOSPITAL_COPILOT_SERVICE_TOKEN=
HOSPITAL_COPILOT_TIMEOUT_SECONDS=8
HOSPITAL_COPILOT_RETRIES=3
# false uniquement pour un certificat auto-signe de demonstration cote hopital (HTTPS=true)
HOSPITAL_COPILOT_VERIFY_TLS=true
# Synchronisation periodique en minutes (0 = desactivee ; la synchronisation manuelle reste disponible)
HOSPITAL_SYNC_INTERVAL_MINUTES=0
HOSPITAL_NAME=Clinique HackCure
# CarePlanAgent : sans cle Anthropic ou si l'appel echoue, le programme est produit par regles (mode de secours)
CARE_AGENT_USE_LLM=true
# true = programme applique sans validation medicale, avec la mention "Valide automatiquement - mode demonstration"
DEMO_AUTO_APPLY=false
# Abonnement : part de l'hopital en % (le reste revient a l'equipe HackCure)
SUBSCRIPTION_HOSPITAL_SHARE_PCT=60
